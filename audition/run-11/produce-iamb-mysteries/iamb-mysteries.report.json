    {
     "group": 0,
     "ratio": 1.61,
     "text": "Xanthus by God, by men Scamander call\u2019d ILIAD XX. V. 74.",
     "line": "p15l0002"
    },
    {
     "group": 0,
     "ratio": 2.57,
     "text": "\u0391\u03b9\u03c4\u03b5\u03b9\u03bd\u03b7 \u03b3\u03b1\u03c1 \u03bf\u03b4\u03bf\u03c2, \u03bc\u03b1\u03ba\u03b1\u03c1\u03c9\u03bd, \u03c4\u03c1\u03b7\u03c7\u03b5\u03b9\u03b1\u03c4\u03b5 \u03c0\u03bf\u03bb\u03bb\u03bf\u03bd,",
     "line": "p15l0011"
    },
    {
     "group": 0,
     "ratio": 1.83,
     "text": "\u03a7\u03b1\u03bb\u03ba\u03bf\u03b5\u03c4\u03bf\u03b9\u03c2 \u03c4\u03b1 \u03c0\u03c1\u03c9\u03c4\u03b1 \u03b4\u03b9\u03bf\u03b9\u03b3\u03bf\u03bc\u03b5\u03bd\u03b7 \u03c0\u03c5\u03bb\u03b5\u03c9\u03c3\u03b9\u03bd.",
     "line": "p15l0012"
    },
    {
     "group": 0,
     "ratio": 1.61,
     "text": "\u0391\u03c4\u03c1\u03bf\u03c0\u03b9\u03c4\u03bf\u03b9 \u03b4\u03b5 \u03b5\u03b1\u03c3\u03c3\u03b9\u03bd \u03b1\u03b8\u03b5\u03c3\u03c6\u03b1\u03c4\u03bf\u03b9 \u03b5\u03b3\u03b3\u03b5\u03b3\u03b1\u03c5\u03b9\u03b1\u03b9,",
     "line": "p15l0013"
    },
    {
     "group": 0,
     "ratio": 2.15,
     "text": "\u0391\u03c2 \u03c0\u03c1\u03c9\u03c4\u03bf\u03b9 \u03bc\u03b5\u03c1\u03bf\u03c0\u03c9\u03bd \u03b5\u03c0\u2019 \u03b1\u03c0\u03b5\u03b9\u03c1\u03bf\u03bd\u03b1 \u03c0\u03c1\u03b7\u03be\u03b9\u03bd \u03b5\u03c6\u03b7\u03bd\u03b1\u03bd,",
     "line": "p15l0014"
    },
    {
     "group": 0,
     "ratio": 1.76,
     "text": "\u039f\u03b9 \u03c4\u03bf \u03ba\u03b1\u03bb\u03bf\u03bd \u03c0\u03b9\u03bd\u03bf\u03bd\u03c4\u03b5\u03c2 \u03c5\u03b4\u03c9\u03c1 \u039d\u03b5\u03b9\u03c9\u03c4\u03b9\u03b4\u03bf\u03c2 \u03b1\u03b9\u03b7\u03c2\u0387",
     "line": "p15l0015"
    },
    {
     "group": 0,
     "ratio": 1.98,
     "text": "\u0391\u03c3\u03c3\u03c5\u03c1\u03b9\u03bf\u03b9, \u039b\u03c5\u03b4\u03bf\u03b9\u03c4\u03b5, \u03ba\u03b1\u03b9 \u0395\u03b2\u03c1\u03b1\u03b9\u03c9\u03bd (lege \u03a7\u03b1\u03bb\u03b4\u03b1\u03b9\u03c9\u03bd) \u03b3\u03b5\u03bd\u03bf\u03c2 \u03b1\u03bd\u03b4\u03c1\u03c9\u03bd.",
